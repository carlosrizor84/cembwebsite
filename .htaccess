# ============================================================================
# CEMB WEBSITE - SECURITY HEADERS & PERFORMANCE CONFIGURATION
# ============================================================================
# Este archivo .htaccess contiene:
# - Headers de seguridad HTTP
# - Configuración de compresión
# - Redirecciones y permisos
# - Caché de navegador
# ============================================================================

# ============================================================================
# 1. SEGURIDAD: Headers HTTP Esenciales
# ============================================================================

# Prevenir clickjacking: No permitir que la página sea embebida en iframes
Header always set X-Frame-Options "SAMEORIGIN"

# Prevenir MIME type sniffing
Header always set X-Content-Type-Options "nosniff"

# Activar XSS Protection en navegadores antiguos
Header always set X-XSS-Protection "1; mode=block"

# Content Security Policy (CSP)
# Esto controla qué recursos pueden cargarse en la página
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' code.jquery.com cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdnjs.cloudflare.com; font-src 'self' fonts.gstatic.com cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'"

# Referrer Policy: Controlar qué información se envía en el referer
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Permisos: Restringir características del navegador
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

# ============================================================================
# 2. HTTPS: Redirigir HTTP a HTTPS
# ============================================================================
# Descomenta las siguientes líneas si tienes certificado SSL configurado:

# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================================
# 3. COMPRESIÓN: Activar GZIP para archivos
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ============================================================================
# 4. CACHÉ DE NAVEGADOR: Mejorar rendimiento
# ============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Imágenes: 1 mes
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    
    # CSS y JavaScript: 2 semanas
    ExpiresByType text/css "access plus 2 weeks"
    ExpiresByType application/javascript "access plus 2 weeks"
    ExpiresByType text/javascript "access plus 2 weeks"
    
    # Fuentes: 1 año (rara vez cambian)
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType application/x-font-woff2 "access plus 1 year"
    
    # HTML: Sin caché (siempre verificar)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================================================
# 5. CONTROL DE CACHÉ EXPLÍCITO
# ============================================================================
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# ============================================================================
# 6. BLOQUEAR ACCESO A ARCHIVOS SENSIBLES
# ============================================================================
<FilesMatch "^\.|\.htaccess|\.htpasswd|\.git|\.env|web\.config|web\.xml">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================================================
# 7. REESCRITURA DE URLs (si necesario)
# ============================================================================
# Habilitar el motor de reescritura
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Eliminar .html de URLs (opcional)
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ============================================================================
# 8. TIPOS MIME COMUNES
# ============================================================================
<IfModule mod_mime.c>
    AddType application/x-font-woff2 .woff2
    AddType application/x-font-woff .woff
    AddType application/json .json
    AddType application/javascript .js
    AddCharset UTF-8 .html .xml .css .js .json .php
</IfModule>

# ============================================================================
# 9. ÍNDICE DE DIRECTORIO
# ============================================================================
# Desactivar listado de archivos en directorios sin index
Options -Indexes

# ============================================================================
# NOTAS DE SEGURIDAD:
# ============================================================================
# 1. Este archivo requiere que Apache tenga mod_rewrite, mod_deflate, mod_expires activados
# 2. Si tu hosting no permite .htaccess, pregunta al proveedor cómo configurar headers
# 3. Para certificado SSL/HTTPS, descomentar la sección de reescritura HTTPS
# 4. CSP puede ser restrictivo. Si ciertos scripts no cargan, ajustar las directivas
# 5. Probar en https://securityheaders.com/ para verificar configuración
# ============================================================================
